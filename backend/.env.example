# Copy to backend/.env and fill in.
APP_NAME=Tameio
MONGO_URL=mongodb://localhost:27017
DB_NAME=tameio
PUBLIC_URL=http://localhost:5173          # where the web app is served (used in emailed links)
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false                       # true in production (HTTPS)

# AI document scanning
ANTHROPIC_API_KEY=                        # required for receipt/invoice scanning
ANTHROPIC_MODEL=claude-opus-5-5

# Email (optional — without it, links are copied instead of emailed)
RESEND_API_KEY=
SENDER_EMAIL=invoices@yourdomain.gr

# Encrypts stored AADE subscription keys. Set a long random value in production.
MYDATA_ENCRYPTION_KEY=

SCHEDULER_ENABLED=true                    # overdue flags, recurring invoices, supplier reminders
UPLOAD_DIR=./uploads

# ΑΦΜ auto-fill: optional AADE registry credentials (without them, the free EU VIES service is used)
AADE_REGISTRY_USER=
AADE_REGISTRY_PASS=

# Partner programme: default revenue share for accounting firms (%)
PARTNER_SHARE_PCT=20

# The app's creator: always sees the Management area and receives bug-report emails
OWNER_EMAIL=gentianhatillari13@gmail.com

# Zeroloop: clears invoices that cancel out between businesses (optional; hidden when unset).
# Register Tameio on Zeroloop with redirect URI {PUBLIC_URL}/api/zeroloop/callback
# and webhook URL {PUBLIC_URL}/api/public/zeroloop/webhook, then paste the values it returns.
ZEROLOOP_URL=
ZEROLOOP_CLIENT_ID=
ZEROLOOP_CLIENT_SECRET=
ZEROLOOP_WEBHOOK_SECRET=
