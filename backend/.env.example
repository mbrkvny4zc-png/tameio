# Copy to backend/.env and fill in.
APP_NAME=Tameio
MONGO_URL=mongodb://localhost:27017
DB_NAME=tameio
PUBLIC_URL=http://localhost:5173          # where the web app is served (used in emailed links)
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false                       # true in production (HTTPS)

# AI document scanning
ANTHROPIC_API_KEY=                        # required for receipt/invoice scanning
ANTHROPIC_MODEL=claude-opus-5-5

# Email (optional — without it, links are copied instead of emailed)
RESEND_API_KEY=
SENDER_EMAIL=invoices@yourdomain.gr

# Encrypts stored AADE subscription keys. Set a long random value in production.
MYDATA_ENCRYPTION_KEY=

SCHEDULER_ENABLED=true                    # overdue flags, recurring invoices, supplier reminders
UPLOAD_DIR=./uploads
